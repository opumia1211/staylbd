APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:vFvJGXZlA0Wd0tpIWqRzhFEiG3YbAk7kHKC1UYY7/QA=
APP_DEBUG=false
APP_URL=http://localhost/staylbd
ASSET_URL=http://localhost/staylbd/core/public
MIX_ASSET_URL=http://localhost/staylbd/core/public

# ---- LOCAL DEV STABILITY (staylbd_wintersm): Do NOT regenerate APP_KEY after users exist. Do NOT run migrate:fresh or migrate:refresh. ----

# Admin panel URL – use custom path for security (never use "admin" in production)
ADMIN_PREFIX=sajaladminopu

LOG_CHANNEL=daily
LOG_LEVEL=error

# Master control database - single connection (staylbd_wintersm). Never run migrate:fresh/refresh in local dev.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=staylbd_wintersm
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=null
# Local: file/sync for stability. Do NOT use SESSION_DRIVER=array (sessions would not persist).
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Feature isolation + library-only asset policy
FEATURE_MODULE_ISOLATION=true
LIBRARY_ONLY_MODE=true
ALLOW_MARKETING_PIXELS=false
ALLOW_LIVE_CHAT_EMBED=false
ALLOW_EXTERNAL_OBSERVABILITY=false
# Subdirectory এ ৪১৯ এড়াতে অবশ্যই পাথ দিন (লগইন ফর্ম সাবমিটে সেশন মিলবে)
