APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: set APP_URL to your real domain (e.g. https://yourdomain.com). Do not use localhost in production.
# APP_ENV=production
# APP_DEBUG=false
# CDN: set ASSET_URL for CSS/JS/Images (e.g. https://cdn.yoursite.com)
ASSET_URL=
# Tawk.to live chat: set to your Property ID (e.g. 1234567/1abc2def) from Tawk.to dashboard
# TAWK_PROPERTY_ID=
# Bump on each deploy so browsers load new CSS/JS (cache busting)
# APP_VERSION=1.0.0

# API: use api/v1 for versioned API; default "api"
# API_PREFIX=api/v1

# Admin panel URL prefix (e.g. admin, sajaladminopu). Change for production security.
ADMIN_PREFIX=admin
# Admin login captcha: default off (like storefront login). Set true for extra bot protection, or toggle in Security dashboard after login.
# ADMIN_LOGIN_CAPTCHA=true

# Production: set ENABLE_ADMIN_CLEAR=false to disable cache clear route
ENABLE_ADMIN_CLEAR=true

# Production security: SESSION_ENCRYPT=true encrypts session data
# SESSION_ENCRYPT=false
# CSP: CSP_REPORT_ONLY=true = monitor, false = enforce; CSP_STRICT=true = remove unsafe-inline
# CSP_REPORT_ONLY=true
# CSP_STRICT=false
# Critical error email (MAIL_FROM_ADDRESS or CRITICAL_ERROR_EMAIL)
# CRITICAL_ERROR_EMAIL=admin@yoursite.com
# Admin: max sessions, invalidate old on login, SVG upload
# ADMIN_MAX_SESSIONS=5
# ADMIN_INVALIDATE_OLD_SESSION_ON_LOGIN=true
# ALLOW_SVG_UPLOAD=true
# Phase 5: Admin IP whitelist (Owner only), environment strict mode
# ADMIN_IP_WHITELIST_ENABLED=false
# ENV_STRICT_MODE=false

# Phase 6: Zero-Trust, data retention, re-auth
# ZERO_TRUST_MODE=false
# REAUTH_REQUIRED_MINUTES=15
# DATA_RETENTION_SECURITY_DAYS=90
# DATA_RETENTION_AUDIT_YEARS=7
# DATA_RETENTION_PAYMENT_YEARS=7

# Deleted files (product/image/logo etc.): keep in trash this many days before permanent delete. Use 15 or 30.
# FILE_RETENTION_DAYS=15

# Optional: Default admin credentials when running AdminSeeder on fresh DB
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin123

# Production: set APP_ENV=production, APP_DEBUG=false, strong APP_KEY
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=error, APP_DEBUG=false
# LOG_DAYS=14 (daily rotation retention)
# LOG_SECURITY_DAYS=90 (security log retention)

# Master control database - single connection controls full site (products, users, orders, admin)
# Hosting: MUST set DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD from your hosting panel (e.g. cPanel).
# "Access denied (using password: NO)" = .env not loaded or DB_PASSWORD empty on server.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wintersm_tt
DB_USERNAME=root
# Set to your MySQL password. XAMPP default is empty. On hosting this is REQUIRED.
DB_PASSWORD=
# DB_STRICT=true (default) – MySQL strict mode. Set false for legacy data.
# DB_STRICT=false

BROADCAST_DRIVER=log
# Production / High traffic: use Redis for cache, session, and queue (required for 100k+ users)
# CACHE_DRIVER=file
# SESSION_DRIVER=file
# QUEUE_CONNECTION=sync
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
# Homepage: defer categories/Power Zone/Featured HTML for guests (smaller first paint). ?full_home=1 disables.
# HOMEPAGE_DEFER_BELOW_FOLD=true
# HOMEPAGE_CACHE_TTL=600
# HOMEPAGE_BANNER_GUEST_CACHE_TTL=300
# Activity logging: queue name for log jobs (default = default)
# ACTIVITY_LOG_QUEUE=default
# ACTIVITY_CACHE_TTL=600
# ACTIVITY_ARCHIVE_AFTER_DAYS=30
# ACTIVITY_DELETE_ARCHIVE_AFTER_DAYS=365
FILESYSTEM_DISK=local
SESSION_LIFETIME=120
# When app is in a subdirectory (e.g. APP_URL=http://localhost/staylbd), set SESSION_PATH so session cookie is sent and 419 is avoided:
# SESSION_PATH=/staylbd
# Increase SESSION_LIFETIME to 480 for longer admin sessions (e.g. product edit, logo/settings)
# Note: Clearing only "Cached images/files" in browser does NOT log you out. Clearing "Cookies and site data" does. See CACHE_AND_SESSION.md

MEMCACHED_HOST=127.0.0.1

# Redis (required when CACHE_DRIVER=redis or SESSION_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
